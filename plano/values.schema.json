{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "enabled",
    "planName",
    "round",
    "profile",
    "nodeNames"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "planName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,40}$"
    },
    "round": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}$"
    },
    "profile": {
      "enum": [
        "micro62",
        "sles"
      ]
    },
    "nodeNames": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "healthTimeoutSeconds": {
      "type": "integer",
      "minimum": 60
    },
    "stableSeconds": {
      "type": "integer",
      "minimum": 10
    },
    "hostTimeoutSeconds": {
      "type": "integer",
      "minimum": 300
    },
    "jobActiveDeadlineSeconds": {
      "type": "integer",
      "minimum": 3600
    },
    "allowEmptyDirDeletion": {
      "type": "boolean"
    },
    "activatePendingSnapshot": {
      "type": "boolean"
    },
    "manageAutomaticUpdates": {
      "type": "boolean"
    },
    "remoteCSIDrivers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hostPathAllowlist": {
      "type": "array"
    },
    "action": {
      "enum": [
        "prepare-host",
        "update"
      ]
    }
  }
}
