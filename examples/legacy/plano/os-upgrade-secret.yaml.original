apiVersion: v1
kind: Secret
metadata:
  name: suc-sle-micro62-scripts
  namespace: cattle-system
type: Opaque
stringData:
  prepare.sh: |
    #!/bin/bash
    set -Eeuo pipefail
    export LC_ALL=C
    SCRIPT_DIR=$(cd -- "$(dirname -- "$0")" && pwd)
    NODE=${SYSTEM_UPGRADE_NODE_NAME:?}
    HASH=${SYSTEM_UPGRADE_PLAN_LATEST_HASH:?}
    [[ $HASH =~ ^[a-zA-Z0-9_-]+$ ]] || exit 1
    STATE=/host/var/lib/suc-sle-micro-6.2/$HASH
    LH_NAMESPACE=${LH_NAMESPACE:-longhorn-system}
    REMOTE_CSI_DRIVERS=${REMOTE_CSI_DRIVERS:-}
    CHECK_TIMEOUT=${CHECK_TIMEOUT:-7200}
    NODE_GROUP=${NODE_GROUP:?}
    k() { kubectl --request-timeout=30s "$@"; }
    die() { echo "BLOQUEADO: $*" >&2; exit 1; }

    # O estado abaixo so pode ser criado pelo upgrade, DEPOIS do drain.
    # Na retomada, esperar replicas saudaveis antes do uncordon pode causar deadlock.
    if [[ -f $STATE/phase ]]; then
      phase=$(cat "$STATE/phase")
      case "$phase" in
        running|reboot-pending|done)
          echo "Retomando $phase; o upgrade verificara o servico, boot ID e snapshot."
          exit 0 ;;
        *) die "Estado $phase em $STATE. Inspecione o journal antes de repetir." ;;
      esac
    fi

    # Verifica o SO real; nao depende somente do label escolhido pelo operador.
    (
      . /host/etc/os-release
      [[ ${VERSION_ID:-} == 6.2 ]] || exit 1
      [[ ${ID:-} == sl-micro || ${ID:-} == sle-micro ]]
    ) || die "Este plano exige SUSE Linux Micro 6.2 ja instalado."

    chroot /host /bin/bash -c '
      set -e
      for tool in transactional-update systemd-run systemctl btrfs flock; do
        command -v "$tool" >/dev/null
      done
      current=$(btrfs inspect-internal rootid /)
      target=$(btrfs subvolume get-default /)
      target=${target#ID }; target=${target%% *}
      [[ "$current" == "$target" ]]
    ' || die "Ferramenta ausente ou snapshot pendente/diferente do snapshot ativo."

    # Timers/reboots externos nao podem disputar a manutencao com o SUC.
    chroot /host /bin/bash -c '
      set -e
      for unit in transactional-update.timer transactional-update.service rebootmgr.service; do
        state=$(systemctl show "$unit" --property=ActiveState --value)
        case "$state" in inactive|failed) ;; *) exit 1 ;; esac
      done
    ' || die "Desative o timer automatico e o rebootmgr; aguarde qualquer transacao em curso."

    if [[ $NODE_GROUP == agent ]]; then
      /bin/bash "$SCRIPT_DIR/wait-servers.sh"
    fi

    version_json=$(k version -o json) || die "Nao foi possivel consultar a versao da API."
    jq -e '
      (.clientVersion.major == .serverVersion.major) and
      ((.clientVersion.minor | capture("(?<n>[0-9]+)").n | tonumber) as $c |
       (.serverVersion.minor | capture("(?<n>[0-9]+)").n | tonumber) as $s |
       (($c - $s) >= -1 and ($c - $s) <= 1))
    ' <<<"$version_json" >/dev/null || die "Ajuste a imagem auxiliar para kubectl compativel com o servidor."

    # Confirma os papeis do no, inclusive servidores exclusivos de etcd.
    node_json=$(k get node "$NODE" -o json) || die "Nao foi possivel consultar o no."
    actual_group=$(jq -r '
      .metadata.labels as $l |
      if ($l | has("node-role.kubernetes.io/control-plane") or
               has("node-role.kubernetes.io/etcd") or
               has("node-role.kubernetes.io/master"))
      then "server" else "agent" end
    ' <<<"$node_json")
    [[ $actual_group == "$NODE_GROUP" ]] || die "Papel $actual_group diverge do plano $NODE_GROUP."

    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    deadline=$((SECONDS + CHECK_TIMEOUT))

    while true; do
      if k get nodes -o json >"$tmp/nodes.json" &&
         k -n "$LH_NAMESPACE" get settings.longhorn.io node-drain-policy disable-scheduling-on-cordoned-node -o json >"$tmp/settings.json" &&
         k -n "$LH_NAMESPACE" get volumes.longhorn.io -o json >"$tmp/volumes.json" &&
         k -n "$LH_NAMESPACE" get nodes.longhorn.io -o json >"$tmp/lh-nodes.json"; then

        # Erro de API/RBAC/CRD nunca e interpretado como Longhorn ausente/saudavel.
        jq -e '
          ([.items[] | select(.metadata.name == "node-drain-policy") | .value][0]
           | . == "block-if-contains-last-replica" or . == "block-for-eviction" or
             . == "block-for-eviction-if-contains-last-replica") and
          ([.items[] | select(.metadata.name == "disable-scheduling-on-cordoned-node") | .value][0] == "true")
        ' "$tmp/settings.json" >/dev/null || die "Longhorn exige politica protetora de drain e disable-scheduling-on-cordoned-node=true."

        if jq -e --arg node "$NODE" '
             (.items | length > 0) and
             all(.items[];
               any(.status.conditions[]?; .type == "Ready" and .status == "True") and
               all(.status.conditions[]?;
                 if (.type == "MemoryPressure" or .type == "DiskPressure" or .type == "PIDPressure")
                 then .status == "False" else true end) and
               (.metadata.name == $node or (.spec.unschedulable != true)))
           ' "$tmp/nodes.json" >/dev/null &&
           jq -e '
             all(.items[];
               (.metadata.deletionTimestamp == null) and
               ((.status.state == "attached" and .status.robustness == "healthy") or
                (.status.state == "detached" and
                 (.status.robustness == "unknown" or .status.robustness == "healthy"))))
           ' "$tmp/volumes.json" >/dev/null &&
           jq -e '
             (.items | length > 0) and
             all(.items[]; any(.status.conditions[]?; .type == "Ready" and .status == "True"))
           ' "$tmp/lh-nodes.json" >/dev/null; then
          break
        fi

        echo "Aguardando nos Ready, sem outra manutencao, e Longhorn saudavel..."
        jq -r '.items[] | [.metadata.name, .status.state, .status.robustness] | @tsv' "$tmp/volumes.json"
      else
        echo "Falha de leitura da API/Longhorn; nenhuma autorizacao de reboot foi concedida."
      fi

      (( SECONDS < deadline )) || die "Timeout na verificacao de saude."
      sleep 20
    done

    # Nao tomar posse de um cordon feito previamente por outro operador/processo.
    unschedulable=$(jq -r --arg node "$NODE" '.items[] | select(.metadata.name == $node) | .spec.unschedulable // false' "$tmp/nodes.json")
    [[ -n $unschedulable ]] || die "No alvo nao encontrado."
    if [[ $unschedulable == true && ! -f $STATE/cordoned-by-plan ]]; then
      die "O no ja estava cordoned antes deste plano."
    fi

    # Cordon ANTES de inventariar PVCs: impede novos pods do scheduler normal.
    # O drain nativo do SUC repetira o cordon de forma idempotente.
    mkdir -p "$STATE"
    chmod 700 "$STATE"
    touch "$STATE/cordoned-by-plan"
    k cordon "$NODE"

    k get pods -A --field-selector "spec.nodeName=$NODE" -o json >"$tmp/pods.json"
    k get pvc -A -o json >"$tmp/pvcs.json"
    k get pv -o json >"$tmp/pvs.json"

    jq -r --arg remote "$REMOTE_CSI_DRIVERS" \
      --slurpfile pvcs "$tmp/pvcs.json" --slurpfile pvs "$tmp/pvs.json" \
      -f "$SCRIPT_DIR/storage-guard.jq" "$tmp/pods.json" >"$tmp/blockers.txt"

    if [[ -s $tmp/blockers.txt ]]; then
      cat "$tmp/blockers.txt" >&2
      die "Armazenamento local/nao revisado em uso. O no permanece cordoned; o SO nao sera atualizado."
    fi

    echo "Preflight aprovado. O drain nativo deve concluir antes de qualquer transacao no SO."

  wait-servers.sh: |
    #!/bin/bash
    set -Eeuo pipefail
    VERSION=${SYSTEM_UPGRADE_PLAN_LATEST_VERSION:?}
    HASH=${SYSTEM_UPGRADE_PLAN_LATEST_HASH:?}
    SERVER_PLAN=os-sle-micro62-server
    WAIT_TIMEOUT=${WAIT_TIMEOUT:-43200}
    k() { kubectl --request-timeout=30s "$@"; }
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    deadline=$((SECONDS + WAIT_TIMEOUT))

    while true; do
      if k -n cattle-system get plans.upgrade.cattle.io "$SERVER_PLAN" -o json >"$tmp/plan.json" &&
         k get nodes -o json >"$tmp/nodes.json"; then

        # Ambos os Plans usam a mesma versao, ServiceAccount e Secret.
        # No SUC 0.17, isso produz o mesmo hash; status antigo nao libera agentes.
        if jq -e --arg version "$VERSION" --arg hash "$HASH" '
             .spec.version == $version and
             .status.latestVersion == $version and
             .status.latestHash == $hash and
             .spec.concurrency == 1 and
             .spec.nodeSelector.matchLabels["suc-micro62"] == "enabled" and
             .spec.nodeSelector.matchLabels["suc-micro62-role"] == "server" and
             ((.status.applying // []) | length == 0) and
             any(.status.conditions[]?; .type == "Complete" and .status == "True")
           ' "$tmp/plan.json" >/dev/null &&
           jq -e --arg hash "$HASH" --arg label "plan.upgrade.cattle.io/$SERVER_PLAN" '
             def server:
               .metadata.labels |
               has("node-role.kubernetes.io/control-plane") or
               has("node-role.kubernetes.io/etcd") or
               has("node-role.kubernetes.io/master");
             [.items[] | select(server)] as $servers |
             ($servers | length > 0) and
             all($servers[];
               .metadata.labels["suc-micro62"] == "enabled" and
               .metadata.labels["suc-micro62-role"] == "server" and
               .metadata.labels[$label] == $hash and
               .spec.unschedulable != true and
               any(.status.conditions[]?; .type == "Ready" and .status == "True"))
           ' "$tmp/nodes.json" >/dev/null; then

          echo "Todos os servidores concluiram esta rodada e estao Ready."
          exit 0
        fi
      fi

      echo "Aguardando todos os servidores: mesma rodada, hash aplicado, Ready e uncordon."
      (( SECONDS < deadline )) || { echo "Timeout aguardando servidores." >&2; exit 1; }
      sleep 20
    done

  storage-guard.jq: |
    # Entradas: pods no no; listas integrais de PVC/PV; CSV de CSI remotos revisados.
    def infra:
      (.metadata.annotations["kubernetes.io/config.mirror"] != null) or
      any(.metadata.ownerReferences[]?; .kind == "DaemonSet");

    def allowed_remote($pv; $remote):
      ($pv.spec.local == null and $pv.spec.hostPath == null) and
      (($pv.spec.csi.driver == "driver.longhorn.io") or
       ($pv.spec.nfs != null) or
       (($pv.spec.csi.driver // "") as $driver |
          $driver != "" and (($remote | split(",") | index($driver)) != null)));

    .items[]
    | select(.status.phase != "Succeeded" and .status.phase != "Failed")
    | select(.metadata.labels["upgrade.cattle.io/controller"] == null)
    | . as $pod
    | .spec.volumes[]?
    | . as $vol
    | if .persistentVolumeClaim then
        ([ $pvcs[0].items[] | select(.metadata.namespace == $pod.metadata.namespace and
           .metadata.name == $vol.persistentVolumeClaim.claimName) ][0]) as $pvc
        | ([ $pvs[0].items[] | select(.metadata.name == $pvc.spec.volumeName) ][0]) as $pv
        | if $pvc == null or $pv == null then
            "\($pod.metadata.namespace)/\($pod.metadata.name): PVC/PV nao resolvido: \($vol.persistentVolumeClaim.claimName)"
          elif allowed_remote($pv; $remote) then empty
          else "\($pod.metadata.namespace)/\($pod.metadata.name): PVC \($pvc.metadata.name), PV \($pv.metadata.name): local/hostPath ou backend nao revisado"
          end
      elif .hostPath and (($pod | infra) | not) then
        "\($pod.metadata.namespace)/\($pod.metadata.name): hostPath \(.hostPath.path)"
      elif .ephemeral or .csi then
        "\($pod.metadata.namespace)/\($pod.metadata.name): volume efemero/CSI inline exige revisao: \(.name)"
      else empty
      end

  upgrade.sh: |
    #!/bin/bash
    set -Eeuo pipefail
    export LC_ALL=C
    SCRIPT_DIR=$(cd -- "$(dirname -- "$0")" && pwd)
    HASH=${SYSTEM_UPGRADE_PLAN_LATEST_HASH:?}
    [[ $HASH =~ ^[a-zA-Z0-9_-]+$ ]] || exit 1
    STATE=/var/lib/suc-sle-micro-6.2/$HASH
    LOCAL_STATE=/host$STATE
    UNIT=suc-micro-$HASH.service
    host() { chroot /host "$@"; }
    die() { echo "BLOQUEADO: $*" >&2; exit 1; }
    mkdir -p "$LOCAL_STATE"
    chmod 700 "$LOCAL_STATE"

    if [[ ! -f $LOCAL_STATE/phase ]]; then
      [[ -f $LOCAL_STATE/cordoned-by-plan ]] || die "Marcador do preflight ausente."
      cp "$SCRIPT_DIR/host-worker.sh" "$LOCAL_STATE/host-worker.sh"
      chmod 700 "$LOCAL_STATE/host-worker.sh"

      host systemd-run --unit="$UNIT" --property=Type=oneshot \
        --property=TimeoutStartSec=7200 \
        /bin/bash "$STATE/host-worker.sh" "$STATE"
    fi

    deadline=$((SECONDS + 7500))
    while (( SECONDS < deadline )); do
      phase=starting
      [[ ! -f $LOCAL_STATE/phase ]] || phase=$(cat "$LOCAL_STATE/phase")

      case "$phase" in
        failed)
          die "Transacao/reboot falhou. Use: journalctl -u $UNIT"
          ;;

        done|reboot-pending)
          target=$(cat "$LOCAL_STATE/target-root")
          [[ $target =~ ^[0-9]+$ ]] || die "Snapshot alvo invalido."
          boot=$(cat /proc/sys/kernel/random/boot_id)
          old_boot=$(cat "$LOCAL_STATE/old-boot")

          if [[ $phase == reboot-pending && $boot == "$old_boot" ]]; then
            echo "Aguardando reboot; o Job ainda nao pode concluir."
          else
            current=$(host btrfs inspect-internal rootid /)
            [[ $current == "$target" ]] || die "Snapshot ativo $current difere de $target; possivel rollback."

            host /bin/bash -c '
              . /etc/os-release
              [[ ${VERSION_ID:-} == 6.2 && ( ${ID:-} == sl-micro || ${ID:-} == sle-micro ) ]]
            ' || die "SO inesperado apos a transacao."

            printf 'done\n' >"$LOCAL_STATE/phase.tmp"
            mv "$LOCAL_STATE/phase.tmp" "$LOCAL_STATE/phase"
            sync
            echo "Concluido: snapshot $current ativo; reboot verificado quando necessario."

            # SUC marca o hash no Node e executa uncordon apos o sucesso do Job.
            exit 0
          fi
          ;;

        starting|running)
          active=$(host systemctl show "$UNIT" --property=ActiveState --value)
          case "$active" in
            activating|active) ;;
            *)
              # O worker pode ter concluido entre a leitura da fase e a do systemd.
              now=$(cat "$LOCAL_STATE/phase" 2>/dev/null || true)
              [[ $now == done || $now == reboot-pending ]] || die "Servico $UNIT esta $active; inspecione o journal."
              ;;
          esac
          ;;

        *)
          die "Fase desconhecida: $phase"
          ;;
      esac

      sleep 10
    done

    die "Timeout aguardando o servico/reboot. Nao avancar manualmente sem diagnostico."

  host-worker.sh: |
    #!/bin/bash
    # Executado pelo systemd DO HOST, fora do ciclo de vida do Pod.
    set -Eeuo pipefail
    export LC_ALL=C
    STATE=${1:?}
    [[ $STATE =~ ^/var/lib/suc-sle-micro-6\.2/[a-zA-Z0-9_-]+$ ]] || exit 1

    exec 9>/var/lib/suc-sle-micro-6.2/host-update.lock
    flock -n 9 || exit 1

    write_state() {
      printf '%s\n' "$2" >"$STATE/$1.tmp"
      mv "$STATE/$1.tmp" "$STATE/$1"
    }

    on_error() {
      rc=$?
      write_state error "exit=$rc; consulte journalctl"
      write_state phase failed
      exit "$rc"
    }

    trap on_error ERR

    . /etc/os-release
    [[ ${VERSION_ID:-} == 6.2 && ( ${ID:-} == sl-micro || ${ID:-} == sle-micro ) ]]

    for unit in transactional-update.timer transactional-update.service rebootmgr.service; do
      state=$(systemctl show "$unit" --property=ActiveState --value)
      [[ $state == inactive || $state == failed ]]
    done

    before=$(btrfs inspect-internal rootid /)
    target=$(btrfs subvolume get-default /)
    target=${target#ID }; target=${target%% *}
    [[ $before =~ ^[0-9]+$ && $target == "$before" ]]

    write_state old-boot "$(cat /proc/sys/kernel/random/boot_id)"
    write_state old-root "$before"
    write_state phase running

    # Patching dentro de 6.2. Sem migration, dup ou modificacao de repositorios.
    transactional-update --non-interactive --drop-if-no-change up

    target=$(btrfs subvolume get-default /)
    target=${target#ID }; target=${target%% *}
    [[ $target =~ ^[0-9]+$ ]]
    write_state target-root "$target"

    if [[ $target == "$before" ]]; then
      write_state phase done
      echo "Nenhum novo snapshot a ativar."
      exit 0
    fi

    write_state phase reboot-pending
    sync
    echo "Snapshot $target preparado. Reiniciando o host."
    systemctl reboot

    # Nao publicar sucesso so porque o pedido de reboot retornou zero.
    # Nao usar soft-reboot: o kernel atualizado tambem precisa ser carregado.
    trap - ERR
    sleep 300
    write_state error "Pedido de reboot nao concluiu em 300 segundos."
    write_state phase failed
    exit 1
